    result=subprocess.run([sys.executable,"-I","-c",code,str(root/"repo/v2"),str(state/"journal.jsonl")],capture_output=True,text=True,check=True,timeout=60)
    return json.loads(result.stdout)

cli=[sys.executable,"-I",str(root/"helpers/cli.py"),"run","--state-dir",str(state),"--stack","dry_stack:stack"]
env=dict(os.environ,SN120_WORK_DIR=str(work)); env.pop("SN120_LOOP_MARK",None)

def run_bounded():
    # A successor ticket during the real stop-after-round path is a failed
    # bound, even if a later crash happens to return the journal to idle.
    unexpected=logs/"gate-second-open"
    with runlog.open("a") as out:
        process=subprocess.Popen(cli,env=env,stdout=out,stderr=subprocess.STDOUT)
        while process.poll() is None:
            state_now=journal_state()
            if state_now["round"]=="r000092":
                unexpected.write_text("r000092\n")
                process.terminate()
                raise RuntimeError("gate stop-after-round opened a successor")
            time.sleep(.03)
        result=process
    if result.returncode: raise RuntimeError(f"real gate run exited {result.returncode}")
    with runlog.open("a") as out: out.write("STOPPED after the round, as asked\n")
    stop.unlink(missing_ok=True); pidfile.unlink(missing_ok=True)

def new_loop():
    with runlog.open("a") as out:
        out.write("run-loop: loop started\n")
        process=subprocess.Popen(cli,env=env,stdout=out,stderr=subprocess.STDOUT)
    deadline=time.monotonic()+1200
    while time.monotonic()<deadline:
        state_now=journal_state()
        if state_now["round"]=="r000093":
            print("real new-code run opened r000093; second worker is held",flush=True)
            (logs/"second-open-observed").write_text("r000093\n")
            return process
        if (os.environ.get("DEDUP_DRY_ABORT_AFTER_OPEN")=="1" and state_now["round"]=="r000092"
                and (logs/"abort-worker-started").exists()):
            (logs/"abort-open-observed").write_text("r000092\n")
            process.wait(timeout=30)
            if process.poll() is None: process.kill(); process.wait()
            assert state_now["decided"] is False,state_now
            pidfile.unlink(missing_ok=True)
            with runlog.open("a") as out: out.write("run-loop: isolated crash after open\n")
            print("undecided-open crash left r000092 open",flush=True)
            return None
        if process.poll() is not None:
            if os.environ.get("DEDUP_DRY_STORE_RESULT_AFTER_OPEN")=="1" or os.environ.get("DEDUP_DRY_DECIDED_OPEN")=="1":
                code='import json,os,sys;sys.path.insert(0,sys.argv[1]);from sn120_v2.state import load;from sn120_v2.store import LocalStore;from sn120_v2 import layout;s=load(sys.argv[2]);r=s.round;store=LocalStore(os.environ["DEDUP_OBJECT_ROOT"]);print(json.dumps({"round":None if r is None else r.round_id,"decided":r is not None and r.decision is not None,"sealed":[] if r is None else [l.lease_id for l in r.leases if store.exists(layout.sealed_result(r.round_id,l.lease_id))]}))'
                result=subprocess.run([sys.executable,"-I","-c",code,str(root/"repo/v2"),str(state/"journal.jsonl")],capture_output=True,text=True,check=True,timeout=60)
                proof=json.loads(result.stdout)
                assert proof["round"]=="r000092" and proof["sealed"],proof
                decided=os.environ.get("DEDUP_DRY_DECIDED_OPEN")=="1"
                assert proof["decided"] is decided,proof
                (logs/("decided-open-proof.json" if decided else "sealed-result-proof.json")).write_text(json.dumps(proof,indent=2)+"\n")
                pidfile.unlink(missing_ok=True)
                print(("decided-open" if decided else "sealed-result")+" crash left r000092 open",flush=True)
                return None
            raise RuntimeError(f"new run exited early {process.returncode}")
        time.sleep(.05)
    raise RuntimeError("real run did not reach the required second open")

phase="gate"; process=None
start=time.monotonic()
while time.monotonic()-start<1800:
    if phase=="gate" and stop.exists():
        run_bounded(); phase="wait-new"
    elif phase=="wait-new" and pidfile.exists():
        process=new_loop(); phase="failed" if process is None else "second"
    if phase in ("failed","second"): break
    time.sleep(.03)
else: raise RuntimeError(f"driver timed out in {phase}")
