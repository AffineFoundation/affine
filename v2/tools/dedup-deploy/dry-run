"""Real controller/admission/worker seams over an isolated affine fixture."""
import dataclasses, hashlib, json, os, pathlib, struct, time
from sn120_v2 import layout
from sn120_v2.admission import StoreAdmission
from sn120_v2.canonical import canonical_json, manifest_digest, sha256_hex
from sn120_v2.controller import HeadPublish, Stack, stored_irt_snapshot
from sn120_v2.irt import IRTSampler
from sn120_v2.pool_runtime import PoolRuntime
from sn120_v2.sim import SimEvaluator, SimFolder, SimTrainer
from sn120_v2.store import LocalStore, promote_fold
from sn120_v2.worker import LocalRunner

class PublicMirrorStore(LocalStore):
    def _mirror(self, key):
        if key.startswith("public/") and not key.startswith("public/pool/state"):
            LocalStore(os.environ["DEDUP_PUBLIC_ROOT"]).put(key, super().get(key))
    def put(self, key, raw):
        answer = super().put(key, raw); self._mirror(key); return answer
    def copy(self, source, target):
        answer = super().copy(source, target); self._mirror(target); return answer

class AffineEvaluator(SimEvaluator):
    """Keep the real image contract while supplying local deterministic scores."""
    def __init__(self, store, image):
        super().__init__(store)
        self.image = image
    def evaluate(self, request):
        return dataclasses.replace(super().evaluate(request), image_digest=self.image)

class AffineTrainer(SimTrainer):
    def train(self, request):
        from sn120_v2.types import LoRAArtifact, TrainReport
        entry, params = request.entry, request.params
        recipe = params.recipe.for_miner(entry.batch.train)
        quality = json.loads((pathlib.Path(os.environ["DEDUP_DRY_QUALITY"])).read_text()).get(entry.batch.batch_sha256, 0.0)
        report = TrainReport(request.seed, recipe.steps, 0.5, 0.1, 1000, 0.1, "cpu", params.recipe.image_digests[0])
        if request.round_id == os.environ.get("DEDUP_FIRST_HEALTH","r000092") and entry.queue_pos == int(os.environ.get("DEDUP_DRY_STORED_NULL_POS","3")):
            report = dataclasses.replace(report,step_norm=float("nan"),norm_before_cap=float("inf"))
        config = canonical_json({"quality":quality,"cap_rate":0.0,"rank":recipe.rank})
        header = json.dumps({"layer.lora_A.weight":{"dtype":"F32","shape":[recipe.rank,1],"data_offsets":[0,4*recipe.rank]},
                             "layer.lora_B.weight":{"dtype":"F32","shape":[1,recipe.rank],"data_offsets":[4*recipe.rank,8*recipe.rank]}},separators=(",",":")).encode()
        weights = struct.pack("<Q",len(header))+header+struct.pack(f"<{2*recipe.rank}f",*([0.2]*recipe.rank+[0.0]*recipe.rank))
        blobs = {"adapter_model.safetensors":weights,"adapter_config.json":config,
                 "train_report.json":canonical_json(__import__("sn120_v2.canonical",fromlist=["to_jsonable"]).to_jsonable(report))}
        for name,raw in blobs.items(): self.store.put(f"{request.out_prefix}/{name}",raw)
        files = {name:sha256_hex(raw) for name,raw in blobs.items()}
        return LoRAArtifact(manifest_digest(files),files,{name:len(raw) for name,raw in blobs.items()},request.out_prefix,
                            request.head.version_id,entry.batch.batch_sha256,params.recipe_id,recipe.rank,recipe.alpha,recipe.target_modules,report)

class Runner:
    def __init__(self,store):
        self.store=store
    def _runner(self,ticket):
        # Simulated wall time stays inside the ticket, but each phase consumes
        # the real evaluation-budget clock rather than passing at a constant time.
        image=ticket.params.recipe.image_digests[0]
        ticks=iter((ticket.issued_at+1,ticket.issued_at+2,*range(ticket.issued_at+3,ticket.issued_at+1236,60)))
        clock=lambda:next(ticks,ticket.issued_at+1235)
        return LocalRunner(AffineTrainer(self.store),AffineEvaluator(self.store,image),clock,image,poll_s=.01)
    def _finish(self,ticket,result):
        return dataclasses.replace(result,started_at=ticket.issued_at+1,finished_at=ticket.issued_at+1236,phase_s={"training":1,"evaluation":1234})
    def run(self,ticket):
        mode=os.environ.get("DEDUP_DRY_ABORT_AFTER_OPEN")=="1"
        abort=pathlib.Path(os.environ["DEDUP_WORK_DIR"])/"logs/abort-open-observed"
        started=pathlib.Path(os.environ["DEDUP_WORK_DIR"])/"logs/abort-worker-started"
        if mode and ticket.round_id==os.environ.get("DEDUP_FIRST_HEALTH","r000092") and not started.exists():
            # The supervisor must observe this actual worker before reporting a
            # crash. Journal-open alone can precede ticket dispatch in a dry run.
            started.touch()
            deadline=time.monotonic()+120
            while not abort.exists():
                if time.monotonic()>deadline: raise RuntimeError("dry abort release missing")
                time.sleep(.01)
            os._exit(70)  # a crashed worker/controller leaves an undecided open round
        release=pathlib.Path(os.environ["DEDUP_WORK_DIR"])/"logs/driver-release"
        if ticket.round_id==os.environ.get("DEDUP_SECOND_OPEN","r000093") and not release.exists():
            deadline=time.monotonic()+1200
            while not release.exists():
                if time.monotonic()>deadline: raise RuntimeError("dry second-open release missing")
                time.sleep(.05)
        result=self._runner(ticket).run(ticket)
        return self._finish(ticket,result)

def stack(context):
    # Each real CLI process sees the checkout that launches it. The helper's
    # initial path is only a bootstrap; rollback must not retain new Params.
    os.environ["DEDUP_V2"]=str(pathlib.Path(__file__).resolve().parents[1]/"repo/v2")
    store=PublicMirrorStore(pathlib.Path(os.environ["DEDUP_OBJECT_ROOT"]))
    state=context.load()
    pool=PoolRuntime(store,state.params,state,root=store.root/"reserve")
    sampler=IRTSampler(pool.active_ids,state.params,snapshot=stored_irt_snapshot(store,state))
    admission=StoreAdmission(store,state.params,tokens=None,grader=None,streams=1)
    return Stack(store,admission,sampler,Runner(store),SimFolder(store),pool=pool,
                 entropy=lambda:"dry-unpredictable-fixture-entropy",head=HeadPublish(promote=promote_fold),mirror=False)
