import os,pathlib
from sn120_v2.journal import Journal
class DecidedOpenJournal(Journal):
    def append(self,kind,data,at):
        record=super().append(kind,data,at)
        crash=pathlib.Path(os.environ["DEDUP_WORK_DIR"])/"logs/decided-open-crash"
        if (os.environ.get("DEDUP_DRY_DECIDED_OPEN")=="1" and kind=="round_settled"
                and data.get("round_id")==os.environ.get("DEDUP_FIRST_HEALTH","r000092") and not crash.exists()):
            assert record.data["decision"] is not None
            assert pathlib.Path(os.environ["DEDUP_STATE"],"journal.jsonl").read_bytes().endswith(record.line()+b"\n")
            crash.write_text(record.data["round_id"]+"\n")
            os._exit(70)
        return record
