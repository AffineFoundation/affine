    if release.exists():
        stop.touch()
        process.wait(timeout=1200)
        assert process.returncode==0,process.returncode
        with runlog.open("a") as out: out.write("STOPPED after the round, as asked\n")
        stop.unlink(missing_ok=True); pidfile.unlink(missing_ok=True)
print("disposable supervisor done",phase,flush=True)
