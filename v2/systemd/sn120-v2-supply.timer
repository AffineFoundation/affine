# Starts sn120-v2-supply.service one time each minute, also after a reboot.
# Enable this timer and not the service. While one run is active, the next start does nothing.

[Unit]
Description=SN120 v2 miner supply record (each minute)

[Timer]
OnCalendar=*-*-* *:*:10
AccuracySec=5s
Persistent=false
Unit=sn120-v2-supply.service

[Install]
WantedBy=timers.target
