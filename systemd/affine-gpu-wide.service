[Unit]
Description=Affine prospective wide-taskset GPU verification and full training
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/const/subnet120-rewrite
Environment=TOKENIZERS_PARALLELISM=false
Environment=OMP_NUM_THREADS=4
Environment=MKL_NUM_THREADS=4
Environment=OPENBLAS_NUM_THREADS=4
Environment=MKL_CBWR=COMPATIBLE
Environment=ATEN_CPU_CAPABILITY=default
Environment=ONEDNN_MAX_CPU_ISA=SSE41
ExecStart=/home/const/subnet120-rewrite/.venv/bin/python -m subnet.gpu_service --config /home/const/subnet120-rewrite/state/gpu-wide-config.json
Restart=on-failure
RestartSec=15
TimeoutStopSec=90
SuccessExitStatus=143

[Install]
WantedBy=default.target
