# Workspace-wide. Package-specific rules live in affine/.gitignore and research/.gitignore.
.env
.venv/
__pycache__/
*.pyc
.DS_Store
**/.eval_env
ralphs/
# mining/ is tracked — the loop's notes and results are the point. Keys,
# loop plumbing, and model weights are not.
mining/wallets/
mining/.env
mining/MNEMONICS.txt
mining/.ralph/
mining/**/*.safetensors
mining/**/*.bin
mining/**/*.gguf
*.egg-info/
