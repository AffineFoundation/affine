#!/bin/bash
# pre-push: refuse a push whose new commits add a secret-shaped literal.
# git feeds "<local ref> <local sha> <remote ref> <remote sha>" per ref on
# stdin. For a ref the remote does not have yet, scan the commits that no
# remote-tracking branch (of ANY remote) has: what is already public is not
# this push's leak, and a brand-new remote must not re-litigate history.
REPO="$(git rev-parse --show-toplevel)"
remote="$1"
zero=0000000000000000000000000000000000000000
rc=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue          # deleting a remote branch
  if [ "$remote_sha" = "$zero" ]; then
    # commits unique to the pushed ref: not on any other local branch or
    # any remote-tracking branch (this box's history is disjoint from
    # origin's — PRs are mirrored — so "what origin has" alone excludes nothing)
    others=$(git for-each-ref --format="%(refname)" refs/heads refs/remotes | grep -vx "$local_ref")
    # shellcheck disable=SC2086
    commits=$(git rev-list "$local_sha" --not $others 2>/dev/null | head -n 500)
  else
    commits=$(git rev-list "$remote_sha..$local_sha" 2>/dev/null | head -n 500)
  fi
  [ -z "$commits" ] && continue
  # shellcheck disable=SC2086
  python3 "$REPO/ops/hooks/secret_scan.py" --commits $commits || rc=1
done
exit $rc
