+            f.seek(base + start)
+            h = hashlib.sha256()
+            left = end - start
+            while left > 0:
+                b = f.read(min(CHUNK, left))
+                if not b:
+                    raise IntegrityError(f"{path.name}: short read inside tensor {name}")
+                h.update(b)
+                left -= len(b)
+                if progress is not None:
+                    progress.add(len(b))
+            out[name] = (str(meta["dtype"]), [int(s) for s in meta["shape"]],
+                         h.hexdigest(), end - start)
+    return out
