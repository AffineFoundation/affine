# Public king chat box — settings for ops/king-chat/chatbox.sh. No secrets.
#
# CHATBOX_*      read by chatbox.sh on the operator box.
# AFFINE_CHAT_*  pushed to the chat pod as /root/affine/.chat_env and read by
#                evalsrv/bootstrap.sh -> engine.py / chatsrv.py (chat role).
#                They override the [chat] toml knobs, which stay sized for
#                the website widget; the public box serves IDE agents.

# Public hostname (Cloudflare tunnel ingress -> 127.0.0.1:CHATBOX_LOCAL_PORT,
# which is the validator's ssh -L forward to the chat pod's chatsrv).
CHATBOX_PUBLIC_HOST=chat.affine.io
CHATBOX_LOCAL_PORT=9002
CHATBOX_CF_TUNNEL_ID=6cfb1dc0-2ef8-41ba-8245-2b581abbbd7f
CHATBOX_ZONE_NAME=affine.io

# vLLM context window on the pod. 131072 fits a ~70 GB king at TP=1 on one
# H200 with KV headroom (same value the private Cursor box has run since
# 2026-09-07); Cursor agent prompts are routinely 20-60k tokens.
AFFINE_CHAT_MAX_MODEL_LEN=131072
# Per-reply cap (thinking tokens count against it since the reasoning
# parser is on). 16k lets an agent write a whole file in one turn.
AFFINE_CHAT_MAX_OUTPUT_TOKENS=16384

# The demo key. Public by design — it appears in the announcement. Rate
# limits below apply to traffic that uses it; the dash proxy and the
# validator use the eval token and are not limited here.
AFFINE_CHAT_PUBLIC_KEY=sk-affine-king
AFFINE_CHAT_PUBLIC_RATE_PER_MIN=60
AFFINE_CHAT_PUBLIC_MAX_CONCURRENCY=8
