{
 "_doc": "SN120 Lium pod roles for ops/pods/replace_pod.py. current_from = the host file the live service reads (source of truth for the pod's id/ip/port). gpu_specs are fallbacks in order; within a spec the cheapest node wins. Paths may use ~ and {RA} (= ~/subnet120-rewrite/state/root-audits).",
 "_limits": {"max_rents_24h_global": 6, "dead_after_min": 20, "auto_max_price_h": 35},
 "_excluded": {"names_re": "casper|tobias|mech-?1", "huids": ["swift-wolf-bd", "zesty-orbit-fe"], "ids": []},
 "_scan_roots": ["~/.config/systemd/user", "{RA}/20261026-promotion-gate/code", "{RA}/20261022-env-probe/code", "{RA}/20261031-performance-eval/code",
                 "{RA}/20261101-prior-table", "{RA}/20261030-plain-disk", "{RA}/20261030-trainer-speed/release", "{RA}/20261031-renorm-step-live/release",
                 "{RA}/20261029-red-skip/release", "{RA}/20261027-k-half/code", "{RA}/20261026-rollback-189de412/scripts", "~/subnet120-rewrite/ops/disk_guard"],

 "bench": {
  "what": "benchmarks node (affine-bench daemon). Rent/bootstrap/release/replace are automatic in bench/affine_bench/pod.py; this tool only reports status.",
  "delegate": "affine-bench daemon (bench/affine_bench/pod.py + bench/deploy/rent.sh + bench/deploy/bootstrap.sh). Manual: bash ~/bench-work/affine/bench/deploy/rent.sh",
  "name": "affine-bench-1", "names": ["affine-bench-1"],
  "current_from": {"file": "~/subnet120-rewrite/state/bench-results/pod.json"},
  "optional": true
 },

 "prior": {
  "what": "prior-table sampler pod (affine-prior-table controller on the host drives it).",
  "name": "affine-prior-1", "names": ["affine-prior-1"],
  "current_from": {"file": "{RA}/20261101-prior-table/pp.sh"},
  "gpu_specs": [{"gpu": "H100", "count": 8, "whole_node": true}, {"gpu": "H200", "count": 8, "whole_node": true}, {"gpu": "B200", "count": 8, "whole_node": true}],
  "max_price_h": 32, "min_disk_gb": 400, "tiers": ["secure", "spot"], "max_rents_24h": 3,
  "auto": true,
  "root": "/opt/prior",
  "provision": [
   {"type": "clone", "dest": "/opt/prior/src/affine"},
   {"type": "script", "script": "ops/pods/provision/vllm_venv.sh", "args": ["/opt/prior"]},
   {"type": "push_dir", "src": "~/subnet120-rewrite/priors", "dest": "/opt/prior/code/priors", "exclude": ["__pycache__", "tests", "*.bak*"]},
   {"type": "push_file", "src": "~/subnet120-rewrite/priors/pod/serve.sh", "dest": "/opt/prior/code/serve.sh", "mode": "755"},
   {"type": "pod_cmd", "cmd": "cp /opt/prior/src/affine/bench/deploy/gate_fetch.py /opt/prior/code/gate_fetch.py"},
   {"type": "push_file", "src": "{RA}/20261101-prior-table/serve.env", "dest": "/opt/prior/serve/serve.env", "optional": true},
   {"type": "push_file", "src": "~/subnet120-rewrite/priors/pod/sampler.config.json", "dest": "/opt/prior/code/sampler.json", "if_missing": true},
   {"type": "push_file", "src": "~/subnet120-rewrite/assets/original-math7496.tasks.json", "dest": "/opt/prior/data/original-math7496.tasks.json", "sha256": "77a4524abc279d0e6e95ec87d0e5604f501c8e409ac5ab656ecabf060ab50fe3"},
   {"type": "push_file", "src": "{RA}/20261101-prior-table/private/dapo_pool.jsonl", "dest": "/opt/prior/data/dapo_pool.jsonl", "sha256": "18d6951e47b85e824fe6f57b986c912d4f939b4c167374e98f4451d18b238a95"},
   {"type": "fetch_head", "ckpt_dir": "/opt/prior/ckpt", "fetch_py": "/opt/prior/code/gate_fetch.py"},
   {"type": "pod_cmd", "cmd": "mkdir -p /opt/prior/logs /opt/prior/tmp && /opt/prior/code/serve.sh {head} 0.90 > /opt/prior/logs/serve-ctl.log 2>&1; tail -1 /opt/prior/logs/serve-ctl.log", "timeout": 2400},
   {"type": "pod_cmd", "cmd": "cd /opt/prior/code && mkdir -p /opt/prior/runs/sampler /opt/prior/hf && rm -f /opt/prior/runs/sampler/STOP && (pid=$(cat /opt/prior/runs/sampler/worker.pid 2>/dev/null); [ -n \"$pid\" ] && kill -0 $pid 2>/dev/null && echo worker-already-running $pid || (TOKENIZERS_PARALLELISM=false TMPDIR=/opt/prior/tmp HF_HUB_OFFLINE=1 HF_HOME=/opt/prior/hf setsid nohup /opt/prior/venv/bin/python -u priors/worker.py sampler.json >> /opt/prior/logs/worker.log 2>&1 < /dev/null & echo worker-started))"}
  ],
  "health": "python3 -c \"import json;s=json.load(open('/opt/prior/serve/SERVING.json'));assert s['replicas']==s['gpus']>0,s;print('OK',s['ckpt'][:12],s['replicas'])\" && kill -0 $(cat /opt/prior/runs/sampler/worker.pid)",
  "repoint": {
   "files": ["{RA}/20261101-prior-table/pp.sh", "{RA}/20261101-prior-table/controller.json"],
   "reset_json": [{"file": "{RA}/20261101-prior-table/private/table/pull.json", "set": {"offset": 0}}],
   "units_stop_first": ["affine-prior-table"], "units_restart": ["affine-prior-table"]
  },
  "verify": {"venv": "/opt/prior/venv", "extra_pins": ["math-verify==0.9.0"], "files": {"/opt/prior/code/serve.sh": "~/subnet120-rewrite/priors/pod/serve.sh", "/opt/prior/code/gate_fetch.py": "~/bench-work/affine/bench/deploy/gate_fetch.py", "/opt/prior/code/priors/worker.py": "~/subnet120-rewrite/priors/worker.py", "/opt/prior/code/priors/grader.py": "~/subnet120-rewrite/priors/grader.py", "/opt/prior/code/sampler.json": "~/subnet120-rewrite/priors/pod/sampler.config.json"}}
 },

