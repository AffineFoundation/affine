+def no_new_evidence(since, until, probe_dir=PROBE_RESULTS, gate_path=GATE_LEDGER, epochs_dir=LIFE_EPOCHS):
+    """2026-10-26 (Jacob pt692u): a frozen flip digest is EXPECTED when no new env-probe result finished in
+    (since, until]: flip pairs only change when a new head checkpoint is probed, and a RED promotion-gate epoch
+    (or a no-update rollback) leaves the head unchanged. Returns (expected, detail)."""
+    new = []
+    for f in glob.glob(os.path.join(probe_dir, '*.private.json')):
+        try:
+            fa = json.load(open(f)).get('finished_at')
+        except Exception:
+            return False, dict(error='unreadable probe result %s' % os.path.basename(f)[:12])
+        if isinstance(fa, (int, float)) and since < fa <= until:
+            new.append(os.path.basename(f)[:12])
+    red, noupd = [], []
+    try:
+        for e in json.load(open(gate_path)).get('entries') or []:
+            if e.get('verdict') == 'rejected' and isinstance((e.get('timestamps') or {}).get('finalized'), (int, float)) \
+                    and (e['timestamps']['finalized'] <= until):
+                red.append(e['epoch'])
+    except Exception:
+        pass
+    for d in glob.glob(os.path.join(epochs_dir, '*', 'FINALIZED.json')):
+        try:
+            m = os.path.getmtime(d)
+            if since - 7200 < m <= until:
+                r = (json.load(open(d)).get('payload') or {}).get('result') or {}
+                if r.get('status') == 'no-update':
+                    noupd.append(int(d.split(os.sep)[-2]))
+        except Exception:
+            pass
+    return (not new), dict(new_probes=new, gate_red_epochs=sorted(red), no_update_epochs=sorted(noupd))
 
 
