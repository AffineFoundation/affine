+# ---- v8.2.9i promotion gate ----
+PG_FLAG = FLAG_PATH.parent / "PROMOTION-GATE.json"
+PG_STATE = Path("/home/const/subnet120-rewrite/state/root-audits/20261026-promotion-gate/state/epochs")
