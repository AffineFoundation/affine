+def _fp32_load(opt, live, entry, emit):
+    """-> True if <store>/<entry> was loaded into opt.masters and verified (digest + bf16 projection == live parameters)."""
+    import torch
+    from safetensors.torch import load_file
+    d = Path(FP32_STORE) / entry
