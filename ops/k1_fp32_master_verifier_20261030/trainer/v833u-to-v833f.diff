+def _fp32_store_entries():
+    root = Path(FP32_STORE)
+    if not root.is_dir():
+        return []
+    rows = []
+    for d in root.iterdir():
+        if d.is_dir() and not d.name.startswith('.') and (d / 'meta.json').is_file():
+            rows.append((d.stat().st_mtime, d))
+    return sorted(rows)
