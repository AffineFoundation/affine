[Unit]
Description=Affine website baseline/curves.json + irt-curves.json (gate-pool-v2 shapes: sorted pass rates + selection probability, binned, no task ids; hard-v1 uses 32K-filter interim until prior samples exist) for affine.io/baseline
[Service]
Type=oneshot
WorkingDirectory=/home/const/subnet120/affine
ExecStart=/usr/bin/python3 -I -B /home/const/subnet120/affine/site-tools/build_baseline_curves.py
ExecStart=/usr/bin/python3 -I -B /home/const/subnet120/affine/site-tools/build_baseline_irt_curves.py
TimeoutStartSec=300
Nice=10
NoNewPrivileges=true
