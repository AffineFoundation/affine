+def drift_settings(engine):
+    """-> (drift_cap_rel or None, restart_lr_warm_steps, restart_lr_scale), validated; defaults are OFF."""
+    cap = engine.get('drift_cap_rel', DRIFT_OFF['drift_cap_rel'])
